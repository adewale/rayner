        {
          "key": "reducer:throw"
        },
        {
          "key": "reducer:throw-box",
          "paint": "stroke"
        },
        {
          "key": "closed"
        },
        {
          "key": "session:ring:closed",
          "paint": "stroke"
        },
        {
          "text": "State"
        },
        {
          "key": "session:state"
        },
        {
          "text": "Event"
        },
        {
          "key": "session:event"
        },
        {
          "text": "Returns"
        },
        {
          "key": "session:returns"
        }
      ]
