{
  "version": 1,
  "claims": [
    {
      "step": "reader-path",
      "opening": true,
      "targets": [
        {
          "key": "reader-picture"
        },
        {
          "text": "idle"
        },
        {
          "text": "connecting"
        },
        {
          "text": "CONNECT"
        }
      ]
    },
    {
      "step": "reader-reject",
      "opening": true,
      "targets": [
        {
          "key": "reader-picture"
        },
        {
          "text": "InvalidTransition"
        },
        {
          "text": "State stays closed"
        }
      ]
    },
    {
      "step": "terminal",
      "targets": [
        {
          "key": "reducer:idle:CONNECT"
        },
        {
          "key": "reducer:connecting:OPENED"
        },
        {
          "key": "reducer:connecting:ERROR"
        },
        {
          "key": "reducer:open:CLOSE"
