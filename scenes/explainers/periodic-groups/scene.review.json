{
  "version": 2,
  "subjects": [
    { "step": "column", "opening": true, "targets": [{ "key": "periodic-family-comparison" }] },
    { "step": "fill", "targets": [{ "text": "run of 2" }, { "text": "run of 6" }, { "text": "run of 10" }, { "text": "run of 14" }, { "text": "Every full run is 2, 6, 10 or 14 cells" }] },
    { "step": "stack", "targets": [{ "text": "2 columns" }, { "text": "10 columns" }, { "text": "6 columns" }] },
    { "step": "names", "targets": [{ "text": "s: 2 columns" }, { "text": "d: 10 columns" }, { "text": "p: 6 columns" }, { "key": "periodic-symbol:2" }] },
    { "step": "blocks", "targets": [{ "text": "d: 10 columns" }, { "text": "p: 6 columns" }, { "text": "2 + 10 + 6 = 18 numbered columns" }] },
    { "step": "blocks", "settings": { "element": "na" }, "targets": [{ "text": "Sodium: 1s² 2s² 2p⁶ 3s¹" }, { "text": "3s¹ starts a run of 2: s column 1, group 1." }] },
    { "step": "blocks", "settings": { "element": "cl" }, "targets": [{ "text": "Chlorine: 1s² 2s² 2p⁶ 3s² 3p⁵" }, { "text": "5th p column, after 2 s and 10 d: 2 + 10 + 5 = 17." }, { "text": "Its 7 after neon alone would say 7: 10 short." }] },
    { "step": "blocks", "settings": { "element": "fe" }, "targets": [{ "text": "Iron: 1s² 2s² 2p⁶ 3s² 3p⁶ 4s² 3d⁶" }, { "text": "6th d column, after 2 s: 2 + 6 = 8." }] },
    { "step": "blocks", "settings": { "element": "cu" }, "targets": [{ "text": "Filling rule: [Ar] 4s² 3d⁹, so 2 + 9 = 11." }, { "text": "NIST lists [Ar] 3d¹⁰ 4s¹: still 11 after [Ar]." }] },
    { "step": "blocks", "settings": { "element": "he" }, "targets": [{ "text": "Helium: 1s², column 2 by its run (He?)," }, { "text": "but 1s² fills shell 1, as 2s² 2p⁶ fills neon’s shell 2." }, { "text": "He?" }] },
    { "step": "family", "settings": { "element": "fe" }, "targets": [{ "text": "4d⁷ 5s¹" }, { "text": "3d⁶ 4s²" }, { "text": "Ru" }] }
  ]
}
