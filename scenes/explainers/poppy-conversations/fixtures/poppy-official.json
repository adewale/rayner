 "schemas": {
  "alternative.schema.json": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "alternative.schema.json",
   "title": "Alternative",
   "description": "Another way to do a task: in an excluded task, or as the body of a 200 response to a feedback report. Spec 9.2 (Alternatives). Personal Agents skip reference types they don't recognize. Web references can point to any HTTPS website or app and don't authorize sending Session JWTs or access tokens. OpenAPI and MCP references name APIs listed in the Company's poppy.json.",
   "type": "object",
   "anyOf": [
    {
     "required": [
      "instructions"
     ]
    },
    {
     "required": [
      "references"
     ]
    }
   ],
   "properties": {
    "instructions": {
     "type": "string",
     "minLength": 1
    },
    "references": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/reference"
     }
    }
   },
   "$defs": {
    "reference": {
     "type": "object",
     "required": [
      "type"
     ],
     "properties": {
      "type": {
       "type": "string",
       "minLength": 1
      },
      "url": {
       "$ref": "poppy.schema.json#/$defs/https_url"
      },
      "operation_id": {
       "type": "string",
       "minLength": 1
      },
      "tool": {
       "type": "string",
       "minLength": 1
      }
     },
     "allOf": [
      {
       "if": {
        "properties": {
         "type": {
          "const": "openapi"
         }
        }
       },
       "then": {
        "required": [
         "url",
         "operation_id"
        ]
       }
      },
      {
       "if": {
        "properties": {
         "type": {
          "const": "mcp"
         }
        }
       },
       "then": {
        "required": [
         "url",
         "tool"
        ]
       }
      },
      {
       "if": {
        "properties": {
         "type": {
          "const": "web"
         }
        }
       },
       "then": {
        "required": [
         "url"
        ]
       }
      }
     ]
    }
   }
  },
  "approval-declined.schema.json": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "approval-declined.schema.json",
   "title": "Declined approval",
   "description": "A Company's final refusal of an approval that passed its checks: it performs nothing and returns no new operation. Operations extension 6 (Declining an approval). At an API, and at the extension's endpoint, the body of an HTTP 403 with error approval_declined. In an MCP tool error result's structuredContent, with error approval_declined. In a Company message's extensions.operations.declined, without error. reason and alternative are content from the Company (spec 10.1), and there are no reason codes. Unknown members are allowed.",
   "type": "object",
   "required": [
    "operation_id",
    "revision"
   ],
   "properties": {
    "error": {
     "const": "approval_declined"
    },
    "operation_id": {
     "$ref": "message.schema.json#/$defs/id"
    },
    "revision": {
     "$ref": "message.schema.json#/$defs/id"
    },
    "reason": {
     "type": "string",
     "minLength": 1,
     "description": "Why, in short plain language for the User. Nothing the Session couldn't already see."
    },
    "alternative": {
     "$ref": "alternative.schema.json"
    }
   }
  },
  "approval.schema.json": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "approval.schema.json",
   "title": "Approval",
   "description": "An approval of one revision of an operation, user approved or agent approved (the Personal Agent approved on the User's instruction), sent by the Personal Agent. Operations extension 5 and 6. In a conversation message's extensions.operations.approval, or in an MCP tool call's _meta under personalagentprotocol.org/approval. At APIs, the same members go in the Poppy-Approval header as a Dictionary Structured Field. Unknown members are ignored.",
   "type": "object",
   "required": [
    "operation_id",
    "revision",
    "approver"
   ],
   "if": {
    "properties": {
     "approver": {
      "const": "agent"
     }
    }
   },
   "then": {
    "not": {
     "required": [
      "input_type"
     ]
    }
   },
   "properties": {
    "operation_id": {
     "$ref": "message.schema.json#/$defs/id"
    },
    "revision": {
     "$ref": "message.schema.json#/$defs/id"
    },
    "approver": {
     "enum": [
      "user",
      "agent"
     ],
     "description": "user for a user approval, agent for an agent approval on the User's instruction. Operations extension 5 and 6."
    },
    "approved_at": {
     "type": "integer",
     "description": "In Unix seconds. With user, when the User approved. With agent, when the Personal Agent approved. Operations extension 6."
    },
    "input_type": {
     "type": "string",
     "description": "Only with user, never with agent. How the User gave their answer, such as tap, typed, or voice. Other values are allowed. Operations extension 6."
    },
    "reference": {
     "$ref": "message.schema.json#/$defs/id",
     "description": "An opaque ID for the Personal Agent's own record of the approval, such as a ledger entry. Never the same at two Companies. Operations extension 6."
    }
   }
  },
  "disclosures-content.schema.json": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "disclosures-content.schema.json",
   "title": "Disclosures extension message content",
   "description": "The value of extensions.disclosures in a Company message (spec 8.4, Disclosures 3).",
   "type": "object",
   "required": [
    "items"
   ],
   "properties": {
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "text"
      ],
      "properties": {
       "text": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    }
   }
  },
  "error.schema.json": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "error.schema.json",
   "title": "Poppy JSON error",
   "description": "An error with a JSON body from an endpoint this protocol or an extension defines, such as conversations (spec 8.13), feedback (9.3), and the browser-session authorization (6), including invalid_session, session_ended, and version_unsupported (HTTP 400, spec 5.3, 5.5, and 3.4) and extension_required (HTTP 403, 3.3), all also at APIs. extension_required names the extension in extension, direct_conversation_open names the open Direct Conversation in conversation_id (8.10), and version_mismatch gives the conversation's protocol version in protocol_version (8.2). Unknown fields are allowed.",
   "type": "object",
   "required": [
    "error"
   ],
   "properties": {
    "error": {
     "type": "string",
     "minLength": 1
    },
    "error_description": {
     "type": "string"
    },
    "extension": {
     "type": "string",
     "minLength": 1
    },
    "conversation_id": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]{1,256}$"
    },
    "protocol_version": {
     "type": "string",
     "pattern": "^[0-9]+\\.[0-9]+$"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "error": {
        "const": "extension_required"
       }
      },
      "required": [
       "error"
      ]
     },
     "then": {
      "required": [
       "extension"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "error": {
        "const": "direct_conversation_open"
       }
      },
      "required": [
       "error"
      ]
     },
     "then": {
      "required": [
       "conversation_id"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "error": {
        "const": "version_mismatch"
       }
      },
      "required": [
       "error"
      ]
     },
     "then": {
      "required": [
       "protocol_version"
      ]
     }
    }
   ]
  },
  "event.schema.json": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "event.schema.json",
   "title": "Conversation event",
   "description": "One event in a conversation, as returned by GET {endpoint}/{id}/events or streamed. Spec sections 8.5 (Reading events), 8.7 (State), 8.10, and 8.11. Every event has id, type, and created_at, and its type says which other fields it has. Personal Agents skip types they don't recognize, so other types are allowed.",
   "type": "object",
   "required": [
    "id",
    "type",
    "created_at"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]{1,256}$"
    },
    "type": {
     "type": "string",
     "minLength": 1
    },
    "created_at": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$",
     "format": "date-time"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "type": {
        "const": "message"
       }
      }
     },
     "then": {
      "required": [
       "message"
      ],
      "properties": {
       "message": {
        "allOf": [
         {
          "$ref": "message.schema.json"
         },
         {
          "required": [
           "id",
           "role"
          ]
         }
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "state"
       }
      }
     },
     "then": {
      "required": [
       "handoff",
       "responder",
       "closed"
      ],
      "properties": {
       "handoff": {
        "enum": [
         "none",
         "pending"
        ]
       },
       "responder": {
        "enum": [
         "agent",
         "human"
        ]
       },
       "closed": {
        "type": "boolean"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "authorization"
       }
      }
     },
     "then": {
      "required": [
       "error",
       "scope"
      ],
      "properties": {
       "error": {
        "const": "insufficient_scope"
       },
       "scope": {
        "type": "string"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "user_requested"
       }
      }
     },
     "then": {
      "required": [
       "reason"
      ],
      "properties": {
       "reason": {
        "type": "string"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "enum": [
         "direct_opened",
         "direct_closed"
        ]
       }
      }
     },
     "then": {
      "required": [
       "conversation_id"
      ],
      "properties": {
       "conversation_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,256}$"
       }
      }
     }
    }
   ]
  },
  "events-response.schema.json": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "events-response.schema.json",
   "title": "Events response",
   "description": "The response to GET {endpoint}/{id}/events, and to a POST with the wait query parameter. Spec sections 8.5 (Reading events) and 8.7 (State). Every successful read includes conversation_id, events, cursor, has_more, and the state fields working, handoff, responder, and closed, with events empty when there are none. cursor is the last event returned, or the request's cursor if there were none; the spec doesn't say what it is for an empty read without a cursor, so null is allowed.",
   "type": "object",
   "required": [
    "conversation_id",
    "events",
    "cursor",
    "has_more",
    "working",
    "handoff",
    "responder",
    "closed"
   ],
   "properties": {
    "conversation_id": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]{1,256}$"
    },
    "events": {
     "type": "array",
     "items": {
      "$ref": "event.schema.json"
     }
    },
    "cursor": {
     "type": [
      "string",
      "null"
     ]
    },
    "has_more": {
     "type": "boolean"
    },
    "working": {
     "type": "boolean"
    },
    "handoff": {
     "enum": [
      "none",
      "pending"
     ]
    },
    "responder": {
     "enum": [
      "agent",
      "human"
     ]
    },
    "closed": {
     "type": "boolean"
    }
   }
  },
  "links-content.schema.json": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "links-content.schema.json",
   "title": "Links extension message content",
   "description": "The value of extensions.links in a Company message (spec 8.4, Links 3).",
   "type": "object",
   "required": [
    "items"
   ],
   "properties": {
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "url"
      ],
      "properties": {
       "url": {
        "type": "string",
        "pattern": "^https://",
        "format": "uri"
       },
       "title": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    }
   }
  },
  "message.schema.json": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "message.schema.json",
   "title": "Conversation message",
   "description": "A message in a Personal Agent Protocol conversation, from either side. Spec sections 8.3 (Sending messages) and 8.4 (Message fields). A message has text, data, context, or extensions. extensions holds content that extensions define, keyed by extension name: operations (Operations extension 2, 4, 6), links, and disclosures are checked here, and other extensions' content must be an object. id and role are set by the Company when it records the message as an event: a Personal Agent message's id is its request's ID. The Personal Agent doesn't send them. as_of_request is only on Company Agent messages and as_of_cursor only on messages the Personal Agent wrote; a message with author.type human has neither (8.4). A context field set to null clears it (8.4). Unknown fields are allowed.",
   "type": "object",
   "required": [
    "author"
   ],
   "properties": {
    "id": {
     "$ref": "#/$defs/id"
    },
    "role": {
     "enum": [
      "user",
      "company"
     ]
    },
    "as_of_request": {
     "$ref": "#/$defs/id"
    },
    "as_of_cursor": {
     "type": "string",
     "minLength": 1
    },
    "text": {
     "type": "string"
    },
    "data": {
     "type": "object"
    },
    "author": {
     "type": "object",
     "required": [
      "type"
     ],
     "properties": {
      "type": {
       "enum": [
        "agent",
        "human"
       ]
      },
      "id": {
       "type": "string",
       "minLength": 1
      },
      "name": {
       "type": "string",
       "minLength": 1
      },
      "image": {
       "type": "string",
       "pattern": "^https://",
       "format": "uri"
      }
     }
    },
    "context": {
     "type": "object",
     "properties": {
      "locale": {
       "type": [
        "string",
        "null"
       ],
       "minLength": 1
      },
      "time_zone": {
       "type": [
        "string",
        "null"
       ],
       "minLength": 1
      },
      "user_available": {
       "type": [
        "boolean",
        "null"
       ]
      }
     }
    },
    "extensions": {
     "type": "object",
     "properties": {
      "operations": {
       "$ref": "operations-content.schema.json"
      },
      "links": {
       "$ref": "links-content.schema.json"
      },
      "disclosures": {
       "$ref": "disclosures-content.schema.json"
      }
     },
     "additionalProperties": {
      "type": "object"
     }
    }
   },
   "anyOf": [
    {
     "required": [
      "text"
     ]
    },
    {
     "required": [
      "data"
     ]
    },
    {
     "required": [
      "context"
     ]
    },
    {
     "required": [
      "extensions"
     ]
    }
   ],
   "$defs": {
    "id": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]{1,256}$"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "author": {
        "properties": {
         "type": {
          "const": "human"
         }
        },
        "required": [
         "type"
        ]
       }
      },
      "required": [
       "author"
      ]
     },
     "then": {
      "not": {
       "anyOf": [
        {
         "required": [
          "as_of_request"
         ]
        },
        {
         "required": [
          "as_of_cursor"
         ]
        }
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "role": {
        "const": "user"
       }
      },
      "required": [
       "role"
      ]
     },
     "then": {
      "not": {
       "required": [
        "as_of_request"
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "role": {
        "const": "company"
       }
      },
      "required": [
       "role"
      ]
     },
     "then": {
      "not": {
       "required": [
        "as_of_cursor"
       ]
      }
     }
    }
   ]
  },
  "operation.schema.json": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "operation.schema.json",
   "title": "Operation",
   "description": "An action the Company performs only once its exact terms are approved, by the User or by the Personal Agent on the User's instruction. Operations extension 3 (The operation). Returned in the body of an approval_required API error, in structuredContent of an MCP tool result, or in a Company message's extensions.operations.operation (Operations 4).",
   "type": "object",
   "required": [
    "operation_id",
    "revision",
    "terms",
    "expires_at"
   ],
   "properties": {
    "operation_id": {
     "$ref": "message.schema.json#/$defs/id"
    },
    "revision": {
     "$ref": "message.schema.json#/$defs/id"
    },
    "summary": {
     "type": "string",
     "minLength": 1
    },
    "terms": {
     "type": "object"
    },
    "expires_at": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$",
     "format": "date-time"
    }
   }
  },
  "operations-content.schema.json": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "operations-content.schema.json",
   "title": "Operations extension message content",
   "description": "The value of extensions.operations in a conversation message (spec 8.4, Operations 2): operation (Operations 4) or declined (Operations 6) in a Company message, approval in a Personal Agent message (Operations 6).",
   "type": "object",
   "properties": {
    "operation": {
     "$ref": "operation.schema.json"
    },
    "approval": {
     "$ref": "approval.schema.json"
    },
    "declined": {
     "$ref": "approval-declined.schema.json",
     "not": {
      "required": [
       "error"
      ]
     }
    }
   },
   "oneOf": [
    {
     "required": [
      "operation"
     ]
    },
    {
     "required": [
      "approval"
     ]
    },
    {
     "required": [
      "declined"
     ]
    }
   ]
  },
  "poppy.schema.json": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "poppy.schema.json",
   "title": "poppy.json",
   "description": "The discovery document a Company publishes at /.well-known/poppy.json. Spec section 3 (Discovery) and 3.1 (Fields). Unknown fields are allowed: Personal Agents ignore fields they don't recognize.",
   "type": "object",
   "required": [
    "protocol_version",
    "organization"
   ],
   "properties": {
    "protocol_version": {
     "type": "string",
     "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "supported_versions": {
     "description": "The other protocol versions the Company serves, each mapped to the HTTPS URL of that version's document, on the host that served poppy.json (spec 3.4). A version's document has no supported_versions.",
     "type": "object",
     "propertyNames": {
      "pattern": "^[0-9]+\\.[0-9]+$"
     },
     "additionalProperties": {
      "$ref": "#/$defs/https_url"
     }
    },
    "organization": {
     "type": "object",
     "required": [
      "name",
      "domain"
     ],
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1
      },
      "domain": {
       "$ref": "#/$defs/domain"
      },
      "logo_uri": {
       "$ref": "#/$defs/https_url"
      }
     }
    },
    "auth": {
     "description": "Optional. issuer is required only when the domain's protected resource metadata lists more than one authorization server, and must then be one of them (spec 3.1, 3.2), which is checked separately.",
     "type": "object",
     "properties": {
      "issuer": {
       "$ref": "#/$defs/https_url"
      },
      "disabled": {
       "description": "true if the Company offers Personal Agents no sign-in, even though it has an issuer (spec 3.2).",
       "type": "boolean"
      },
      "scopes": {
       "description": "Scope descriptions, keyed by scope name, in the same form as an OpenAPI OAuth 2.0 security scheme. Describing offered scopes here or in a listed OpenAPI description is recommended.",
       "type": "object",
       "additionalProperties": {
        "type": "string",
        "minLength": 1
       }
      },
      "scope_hints": {
       "description": "Hints about each scope, keyed by scope name, describing the most consequential operation that requires it.",
       "type": "object",
       "additionalProperties": {
        "type": "object",
        "required": [
         "changes",
         "personal_data"
        ],
        "properties": {
         "changes": {
          "enum": [
           "none",
           "reversible",
           "irreversible"
          ]
         },
         "personal_data": {
          "type": "boolean"
         }
        }
       }
      }
     }
    },
    "agent": {
     "type": "object",
     "required": [
      "protocols"
     ],
     "properties": {
      "protocols": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "required": [
         "type",
         "endpoint",
         "description"
        ],
        "properties": {
         "type": {
          "type": "string",
          "minLength": 1
         },
         "endpoint": {
          "$ref": "#/$defs/https_url"
         },
         "description": {
          "type": "string",
          "minLength": 1,
          "description": "What the agent at this endpoint can help with. It may say anything (spec 8.1)."
         },
         "access": {
          "type": "string",
          "description": "For a poppy protocol entry, session (the default) or signed_in. Unknown values are ignored as an absent hint (spec 3.2)."
         }
        }
       }
      }
     }
    },
    "tasks": {
     "type": "object",
     "required": [
      "endpoint"
     ],
     "properties": {
      "endpoint": {
       "$ref": "#/$defs/https_url"
      }
     }
    },
    "web": {
     "type": "object",
     "properties": {
      "browser_session_endpoint": {
       "$ref": "#/$defs/https_url"
      },
      "disabled": {
       "description": "true if the Company asks Personal Agents not to browse its website, and to use its Company Agent and APIs instead (spec section 6).",
       "type": "boolean"
      },
      "unscoped": {
       "description": "true if the website doesn't apply the Company's other scopes, so poppy:browser-sign-in gives the account's full access there (spec section 6).",
       "type": "boolean"
      }
     }
    },
    "apis": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "type",
       "url",
       "description"
      ],
      "properties": {
       "type": {
        "type": "string",
        "minLength": 1
       },
       "url": {
        "$ref": "#/$defs/https_url"
       },
       "description": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    },
    "extensions": {
     "type": "object",
     "properties": {
      "mediated-sign-in": {
       "description": "The Mediated Sign-In extension (Mediated Sign-In 2), with an entry for each version. Version 1 has the credentials to collect, each sent as a token request parameter of that name, and the scopes it can grant. The grant is at the issuer's token_endpoint, which lists https://personalagentprotocol.org/grant/mediated-sign-in in grant_types_supported.",
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "required": [
         "version"
        ],
        "properties": {
         "version": {
          "type": "string",
          "minLength": 1
         }
        },
        "if": {
         "properties": {
          "version": {
           "const": "1"
          }
         }
        },
        "then": {
         "required": [
          "version",
          "fields",
          "scopes"
         ],
         "properties": {
          "version": {
           "type": "string",
           "minLength": 1
          },
          "fields": {
           "type": "array",
           "minItems": 1,
           "items": {
            "type": "object",
            "required": [
             "name",
             "label",
             "secret"
            ],
            "properties": {
             "name": {
              "description": "Not grant_type, scope, resource, a client authentication parameter such as client_id or client_assertion, or a parameter the extension defines, such as sign_in_id.",
              "type": "string",
              "minLength": 1,
              "not": {
               "enum": [
                "grant_type",
                "scope",
                "client_id",
                "client_secret",
                "client_assertion",
                "client_assertion_type",
                "resource",
                "sign_in_id",
                "one_time_code"
               ]
              }
             },
             "label": {
              "type": "string",
              "minLength": 1
             },
             "secret": {
              "type": "boolean"
             }
            }
           }
          },
          "scopes": {
           "$ref": "#/$defs/scopes"
          }
         }
        }
       }
      }
     },
     "additionalProperties": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "version"
       ],
       "properties": {
        "version": {
         "type": "string",
         "minLength": 1
        },
        "endpoint": {
         "$ref": "#/$defs/https_url"
        }
       }
      }
     },
     "description": "The extensions the Company supports, keyed by name, each a list with an entry for each major version (spec 3.3)."
    }
   },
   "allOf": [
    {
     "anyOf": [
      {
       "required": [
        "agent"
       ]
      },
      {
       "required": [
        "apis"
       ]
      },
      {
       "required": [
        "web"
       ]
      }
     ]
    }
   ],
   "$defs": {
    "https_url": {
     "type": "string",
     "pattern": "^https://[^\\s/?#]+",
     "format": "uri"
    },
    "domain": {
     "type": "string",
     "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+(:[1-9][0-9]{0,4})?$"
    },
    "scopes": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "pattern": "^[\\x21\\x23-\\x5B\\x5D-\\x7E]+$"
     }
    }
   }
  }
 }
}
