 "examples": {
  "8.3 Sending messages #1 (Personal Agent)": {
   "id": "msg_Yq3v8LrT0aWc5NkE",
   "message": {
    "author": {
     "type": "agent"
    },
    "text": "The jacket from order #1042 isn't warm enough. The user wants to return it.",
    "context": {
     "locale": "en-US",
     "time_zone": "America/Los_Angeles",
     "user_available": true
    }
   }
  },
  "8.3 Sending messages #3 (Personal Agent)": {
   "id": "msg_Hc72PwZn4eKs1QxB",
   "message": {
    "author": {
     "type": "agent"
    },
    "text": "Does the insulated version come in medium?"
   }
  },
