{
  // The library: src/ -> dist/ (ESM .js, .d.ts, declaration maps). Runtime-agnostic,
  // but DomSink is typed against the DOM, so lib.dom is in scope.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    // Members marked @internal (Mobject.id) are left out of the published types.
    "stripInternal": true,
    "sourceMap": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/lib.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "explain/**/*.ts", "integrations/agentic-mermaid/*.ts"],
  "exclude": ["integrations/agentic-mermaid/build"]
}
