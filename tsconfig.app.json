{
  // Browser code: the embed (app/, bundled into each page by `rayner build`)
  // and the explainer scenes. Checked only; nothing is emitted.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/app.tsbuildinfo"
  },
  "include": ["app/**/*.ts", "scenes/**/*.ts"],
  // A folder's tests, fidelity checks and oracles, and the shared property-test settings, run in Node;
  // tsconfig.node.json checks them.
  "exclude": ["scenes/**/*.test.ts", "scenes/**/fidelity.ts", "scenes/**/oracle/**", "scenes/explainers/lib/pbt.ts", "scenes/explainers/lib/oracle.ts"]
}
