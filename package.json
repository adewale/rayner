{
  "name": "rayner",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "build:lib": "rm -rf dist && tsc -p tsconfig.lib.json && node tools/copy-vendor.ts && node tools/build-cli.ts",
    "test": "node --expose-gc --test test/*.test.ts",
    "test:full": "FULL=1 node --expose-gc --test test/*.test.ts",
    "fonts": "tools/fonts.sh",
    "fonts:lettering": "tools/lettering-fonts.sh",
    "fonts:lettering-outlines": "bash tools/lettering-outline-fonts.sh",
    "check": "tsc -b && node tools/copy-vendor.ts && tsc -p test/consumer/tsconfig.json",
    "prepack": "npm run build:lib",
    "rayner": "node tools/explain.ts",
    "demos:build": "node tools/explain-demos.ts",
    "demos:check": "node tools/explain-demos.ts --check",
    "demos:serve": "node tools/explain-serve.ts",
    "demos:review": "node tools/explain-review.ts",
    "check:budgets": "node tools/page-budgets.ts",
    "pack:smoke": "node tools/explain-package-smoke.ts",
    "site:export": "node tools/explain-site.ts",
    "test:embeds": "EXPLAIN_BROWSER=1 node --test test/explain-player-style.test.ts test/explain-capture.test.ts test/explain-embed.test.ts test/explain-loading.test.ts test/explain-reference-reader.test.ts test/explain-audio.test.ts test/explain-periodic-reader.test.ts test/explain-monty-reader.test.ts test/explain-ring-reader.test.ts test/explain-birthday-reader.test.ts test/lettering-browser.test.ts test/lettering-math.test.ts test/explain-lang.test.ts test/svg-browser.test.ts test/explain-story-review.test.ts test/explain-review-scene.test.ts test/bench-measure.test.ts",
    "release:check": "node tools/prepare-release.ts",
    "bench": "node tools/bench.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "shiki": "4.5.0"
  },
  "description": "Step-through technical explainers from one TypeScript scene. Portable HTML with no browser runtime dependencies.",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./explain": {
      "types": "./dist/explain/index.d.ts",
      "default": "./dist/explain/index.js"
    },
    "./lettering": {
      "types": "./dist/src/lettering.d.ts",
      "default": "./dist/src/lettering.js"
    }
  },
  "bin": {
    "rayner": "dist/tools/explain.js"
  },
  "author": "Ade Oshineye (https://github.com/adewale)",
  "license": "MIT",
  "sideEffects": false,
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "src",
    "explain",
    "integrations",
    "app/embed*",
    "app/loader.ts",
    "skills",
    "scenes/tutorial",
    "tools/lettering.py",
    "tools/lib/lettering.ts",
    "tools/lib/lettering-validation.ts",
    "vendor/glyph-math.js",
    "vendor/glyph-math.d.ts",
    "tools/lettering-outline-fonts.sh",
    "tools/lettering-requirements.txt",
    "vendor/glyph.js",
    "vendor/glyph.pin.json",
    "vendor/font-data-sfnt.json",
    "vendor/glyph.d.ts",
    "vendor/lettering",
    "vendor/licenses",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adewale/rayner.git"
  },
  "keywords": [
    "animation",
    "svg",
    "manim",
    "explainer",
    "stepper",
    "embed",
    "mermaid"
  ],
  "dependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "agentic-mermaid": "0.5.1",
    "playwright-core": "1.64.1",
    "svgpath": "2.6.0",
    "@resvg/resvg-js": "2.6.2"
  },
  "homepage": "https://oshineye.dev/projects/rayner",
  "bugs": {
    "url": "https://github.com/adewale/rayner/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
