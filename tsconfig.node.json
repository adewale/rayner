{
  // Node code: tools/, test/ and each explainer folder's tests, fidelity checks and oracles, run as .ts by
  // Node 24 (type stripping). Checked only.
  // lib.dom too: tools drive Chromium and type what runs in the page.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "noEmit": true,
    "resolveJsonModule": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/node.tsbuildinfo"
  },
  "include": ["tools/**/*.ts", "test/**/*.ts", "scenes/**/*.test.ts", "scenes/**/fidelity.ts", "scenes/**/oracle/**/*.ts", "scenes/explainers/lib/pbt.ts", "scenes/explainers/lib/oracle.ts", "recipes/**/*.ts"],
  "exclude": ["test/consumer"]
}
